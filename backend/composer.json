{
    "name": "myapp/backend",
    "description": "Backend for My Application",
    "type": "project",
    "require": {
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5",
        "flightphp/core": "^3.0",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
